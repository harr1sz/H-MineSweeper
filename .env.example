H_MINESWEEPER_HOST=127.0.0.1
H_MINESWEEPER_PORT=3001
H_MINESWEEPER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
H_MINESWEEPER_LOG_LEVEL=info
# Trusted reverse-proxy hops (0-2). Keep 0 when server is directly exposed.
H_MINESWEEPER_TRUST_PROXY_HOPS=0
H_MINESWEEPER_GUEST_SESSION_TTL_MS=21600000
H_MINESWEEPER_TICKET_TTL_MS=30000
H_MINESWEEPER_TICKET_EPOCH_TTL_MS=86400000
H_MINESWEEPER_ROOM_IDLE_TTL_MS=900000
H_MINESWEEPER_DUEL_EXPERIMENT=true
H_MINESWEEPER_MAX_TELEMETRY_SESSIONS=50000
H_MINESWEEPER_TELEMETRY_SQLITE_FILE=
H_MINESWEEPER_TELEMETRY_REQUIRE_PERSISTENT_STORE=false
# Use a deployment secret with at least 32 characters.
H_MINESWEEPER_TELEMETRY_SECRET=
H_MINESWEEPER_TELEMETRY_AGGREGATE_TTL_MS=2592000000
H_MINESWEEPER_MAX_RAW_TELEMETRY_EVENTS=250000
H_MINESWEEPER_MAX_RAW_TELEMETRY_BYTES=268435456
H_MINESWEEPER_MAX_TELEMETRY_AGGREGATE_BUCKETS=10000
H_MINESWEEPER_REST_RATE_LIMIT_PER_MINUTE=120
H_MINESWEEPER_REST_RATE_LIMIT_BURST=30
H_MINESWEEPER_REST_RATE_LIMIT_MAX_BUCKETS=50000
H_MINESWEEPER_MAX_GUEST_SESSIONS=10000
H_MINESWEEPER_MAX_ROOMS=2000
H_MINESWEEPER_MAX_REPLAY_RESPONSE_BYTES=5242880
H_MINESWEEPER_MAX_REPLAY_EVENTS=10000
H_MINESWEEPER_MAX_REPLAY_BYTES=5242880
H_MINESWEEPER_MAINTENANCE_INTERVAL_MS=30000
H_MINESWEEPER_BUILD_SHA=development
H_MINESWEEPER_REGION=local
H_MINESWEEPER_APP_VERSION=0.2.0-alpha.1
H_MINESWEEPER_LOCAL_SCHEMA_VERSION=HMS-local-history-v1
# Compose release references accept a tag for local build validation. Internet
# Alpha deployment must replace these with registry/name@sha256:digest.
H_MINESWEEPER_SERVER_IMAGE_REF=h-minesweeper/server:0.2.0-alpha.1
H_MINESWEEPER_WEB_IMAGE_REF=h-minesweeper/web:0.2.0-alpha.1
# Optional override used by the Vite development proxy.
VITE_DEV_SERVER_URL=http://127.0.0.1:3001
# Local development keeps optional telemetry and duel experiments off by default.
VITE_TELEMETRY_ENABLED=false
# Local Vite development only. Reference Compose derives both client and server
# duel flags from H_MINESWEEPER_DUEL_EXPERIMENT.
VITE_DUEL_EXPERIMENT=true
VITE_APP_VERSION=0.2.0-alpha.1
VITE_BUILD_SHA=development
VITE_BUILD_REGION=local
