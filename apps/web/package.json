{
  "name": "@h-minesweeper/web",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "e2e": "playwright test && playwright test --config playwright.alpha.config.ts && playwright test --config playwright.dist.config.ts",
    "e2e:alpha": "playwright test --config playwright.alpha.config.ts",
    "e2e:dist": "playwright test --config playwright.dist.config.ts",
    "e2e:list": "playwright test --list && playwright test --config playwright.alpha.config.ts --list && playwright test --config playwright.dist.config.ts --list",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@h-minesweeper/game-core": "workspace:*",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
